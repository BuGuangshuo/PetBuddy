{
  "name": "petbuddy",
  "version": "0.1.0",
  "description": "A macOS desktop pet that keeps you on rhythm.",
  "main": "./out/main/index.js",
  "author": "OpenAI Codex",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "electron-updater": "6.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.0.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "7.3.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.alanbu.petbuddy",
    "productName": "PetBuddy",
    "files": [
      "out/**/*",
      "package.json",
      "pet_assets/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
